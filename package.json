{
  "name": "hardhat-project",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test --network hardhat",
    "deploy:smartWalletFactory": "npx hardhat run scripts/deploySmartWalletFactory.ts --network",
    "deploy:tokenFactory": "npx hardhat run scripts/deployTokenFactory.ts --network",
    "verify:factory": "npx hardhat verify --contract contracts/SmartWalletV1/SmartWalletFactory.sol:SmartWalletFactoryV1 --network",
    "verify:tokenFactory": "npx hardhat verify --contract contracts/TokenFactory/TokenFactory.sol:TokenFactory --network",
    "predict:wallet": "npx hardhat run scripts/predictWallet.js --network",
    "create:wallet": "npx hardhat run scripts/createWallet.js --network",
    "verify:wallet": "npx hardhat verify --contract contracts/SmartWalletProxy.sol:SmartWalletProxy --constructor-args scripts/args.js --network",
    "coverage": "COVERAGE=true npx hardhat coverage",
    "kms:address": "npx hardhat run scripts/kmsAddress.ts --network",
    "doctor": "npx hardhat run scripts/doctor.ts --network"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1125.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/hdkey": "^2.1.0",
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1",
    "hardhat-contract-sizer": "^2.10.1",
    "hdkey": "^2.1.0"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "ethers": "^6.17.0"
  }
}